{
  "font_family": "JetBrainsMono Nerd Font Mono",
  "font_fallbacks": [
    "Menlo",
    "Sarasa Term SC",
    "PingFang SC",
    "Apple Color Emoji"
  ],
  "font_family_bold": null,
  "font_family_italic": null,
  "font_features": null,
  "font_thicken": true,
  "font_size": 14.0,
  "line_height": 1.4,
  "ui_font_family": null,
  "theme_preset": "claude_light",
  "theme_follow_system": true,
  "theme_preset_light": "claude_light",
  "theme_preset_dark": "claude_dark",
  "theme_legible_palette": true,
  "window_opacity": null,
  "window_blur": null,
  "window_backdrop": "auto",
  "keybindings": {},
  "keybinding_preset": "default",
  "prefix": "ctrl-b",
  "shell": null,
  "link_url": true,
  "link_file_open": "system",
  "link_file_command": null,
  "cursor_blink": true,
  "scrollback_limit": 10000,
  "notify_on_command_finish": "unfocused",
  "gui_language": "zh-CN",
  "notify_threshold_secs": 10,
  "confirm_close": "when-busy",
  "bell": "visual",
  "prompt_editor": false,
  "tab_completion": false,
  "history_search": true,
  "cursor_style": "block",
  "prompt_cursor_style": "follow",
  "macos_option_as_alt": false,
  "mouse_hide_while_typing": true,
  "focus_follows_mouse": false,
  "mouse_scroll_multiplier": 1.0,
  "smooth_scroll": true,
  "mouse_reporting": true,
  "mouse_zoom_modifier": "none",
  "clipboard_trim_trailing_spaces": true,
  "copy_join_wrapped": false,
  "copy_on_select": true,
  "smart_select": true,
  "word_separators": ",│`|:\"' ()[]{}<>\t",
  "startup_mode": "normal",
  "working_directory": {
    "strategy": "inherit",
    "path": ""
  },
  "env": {},
  "agent_commands": {},
  "agent_launch": {},
  "per_pane_history": false
}